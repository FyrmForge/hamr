package web

import (
	"github.com/FyrmForge/hamr/pkg/server"

	"{{.Module}}/internal/web/handler/about"
)

// RegisterStaticPages registers handlers marked for static generation.
// These handlers must not depend on database or session state.
func RegisterStaticPages(srv *server.Server) {
	h := about.NewHandler()
	srv.StaticPage("/about", h.About)
}
