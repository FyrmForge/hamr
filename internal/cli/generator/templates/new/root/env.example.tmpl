# Server
PORT=8080
DEV_MODE=true

# Base URL (set in production for cookie domain and CORS, leave empty for local dev)
# BASE_URL=https://example.com

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{.Name}}?sslmode=disable
{{- if eq .StorageBackend "local"}}

# Storage
STORAGE_PATH=./uploads
{{- end}}
{{- if eq .StorageBackend "s3"}}

# S3 Storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET={{.Name}}-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
{{- if .StaticS3}}
S3_STATIC_BUCKET={{.Name}}-static
{{- end}}
{{- end}}

{{- if .IncludeStripe}}

# Stripe
STRIPE_WEBHOOK_SECRET=whsec_...
{{- end}}

# Static assets base URL (override with CDN URL in production)
STATIC_BASE_URL=/static
