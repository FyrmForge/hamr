package auth

import (
	"errors"
	"log/slog"
	"net/http"
	"strings"

	"github.com/FyrmForge/hamr/pkg/auth"
	"github.com/FyrmForge/hamr/pkg/middleware"
	"github.com/FyrmForge/hamr/pkg/respond"
	"github.com/FyrmForge/hamr/pkg/validate"
	"github.com/labstack/echo/v4"

	"{{.Module}}/internal/service"
	"{{.Module}}/internal/web/components/form"
)

// Handler handles authentication requests.
type handler struct {
	authService    *service.AuthService
	sessionManager *auth.SessionManager
	log            *slog.Logger
}

// NewHandler creates a new auth handler.
func NewHandler(authService *service.AuthService, sm *auth.SessionManager, log *slog.Logger) *handler {
	return &handler{
		authService:    authService,
		sessionManager: sm,
		log:            log,
	}
}

// GET /login
func (h *handler) LoginPage(c echo.Context) error {
	return respond.HTML(c, http.StatusOK, loginPage(c, "", nil))
}

// POST /login
func (h *handler) Login(c echo.Context) error {
	email := strings.ToLower(c.FormValue("email"))
	password := c.FormValue("password")

	fieldErrors := make(map[string]string)

	if msg := validate.Required(email); msg != "" {
		fieldErrors["email"] = msg
	} else if msg := validate.Email(email); msg != "" {
		fieldErrors["email"] = msg
	}

	if msg := validate.Required(password); msg != "" {
		fieldErrors["password"] = msg
	}

	if len(fieldErrors) > 0 {
		return respond.HTML(c, http.StatusUnprocessableEntity, loginForm(c, email, fieldErrors))
	}

	user, err := h.authService.Authenticate(c.Request().Context(), email, password)
	if err != nil {
		h.log.Warn("login failed", "email", email, "error", err)
		fieldErrors["general"] = "Invalid email or password"
		return respond.HTML(c, http.StatusUnauthorized, loginForm(c, email, fieldErrors))
	}

	session, err := h.sessionManager.CreateSession(c.Request().Context(), user.ID, nil)
	if err != nil {
		h.log.Error("create session failed", "error", err)
		return echo.NewHTTPError(http.StatusInternalServerError, "session error")
	}

	h.setSessionCookie(c, session)
	return respond.Redirect(c, "/")
}

// POST /login/validate/:field
func (h *handler) ValidateLoginField(c echo.Context) error {
	field := c.Param("field")
	value := c.FormValue(field)
	var errMsg string

	switch field {
	case "email":
		if msg := validate.Required(value); msg != "" {
			errMsg = msg
		} else if msg := validate.Email(value); msg != "" {
			errMsg = msg
		}
	case "password":
		if msg := validate.Required(value); msg != "" {
			errMsg = msg
		}
	}

	status := http.StatusOK
	if errMsg != "" {
		status = http.StatusUnprocessableEntity
	}
	return respond.HTML(c, status, form.FieldErrorOOB(field, errMsg))
}

// GET /register
func (h *handler) RegisterPage(c echo.Context) error {
	return respond.HTML(c, http.StatusOK, registerPage(c, "", "", nil))
}

// POST /register
func (h *handler) Register(c echo.Context) error {
	name := c.FormValue("name")
	email := strings.ToLower(c.FormValue("email"))
	password := c.FormValue("password")

	fieldErrors := make(map[string]string)
	if msg := validate.Required(name); msg != "" {
		fieldErrors["name"] = msg
	}
	if msg := validate.Email(email); msg != "" {
		fieldErrors["email"] = msg
	}
	if msg := validate.PasswordStrength(password); msg != "" {
		fieldErrors["password"] = msg
	}
	if len(fieldErrors) > 0 {
		return respond.HTML(c, http.StatusUnprocessableEntity, registerForm(c, name, email, fieldErrors))
	}

	user, err := h.authService.Register(c.Request().Context(), email, password, name)
	if err != nil {
		h.log.Warn("registration failed", "email", email, "error", err)
		if errors.Is(err, service.ErrEmailTaken) {
			fieldErrors["email"] = "An account with this email already exists"
		} else {
			fieldErrors["general"] = "Registration failed. Please try again."
		}
		return respond.HTML(c, http.StatusUnprocessableEntity, registerForm(c, name, email, fieldErrors))
	}

	session, err := h.sessionManager.CreateSession(c.Request().Context(), user.ID, nil)
	if err != nil {
		h.log.Error("create session failed", "error", err)
		return echo.NewHTTPError(http.StatusInternalServerError, "session error")
	}

	h.setSessionCookie(c, session)
	middleware.SetFlash(c, "Welcome! Your account has been created.", middleware.FlashSuccess)
	return respond.Redirect(c, "/")
}

// POST /register/validate/:field
func (h *handler) ValidateRegisterField(c echo.Context) error {
	field := c.Param("field")
	value := c.FormValue(field)
	var errMsg string

	switch field {
	case "name":
		errMsg = validate.Required(value)
	case "email":
		if msg := validate.Required(value); msg != "" {
			errMsg = msg
		} else if msg := validate.Email(value); msg != "" {
			errMsg = msg
		}
	case "password":
		errMsg = validate.PasswordStrength(value)
	}

	status := http.StatusOK
	if errMsg != "" {
		status = http.StatusUnprocessableEntity
	}
	return respond.HTML(c, status, form.FieldErrorOOB(field, errMsg))
}

// POST /logout
func (h *handler) Logout(c echo.Context) error {
	cookie, err := c.Cookie(h.sessionManager.CookieName())
	if err == nil {
		session, _ := h.sessionManager.ValidateSession(c.Request().Context(), cookie.Value)
		if session != nil {
			_ = h.sessionManager.DeleteSession(c.Request().Context(), session.ID)
		}
	}

	c.SetCookie(&http.Cookie{
		Name:     h.sessionManager.CookieName(),
		Value:    "",
		Path:     h.sessionManager.CookiePath(),
		Domain:   h.sessionManager.CookieDomain(),
		MaxAge:   -1,
		HttpOnly: true,
		Secure:   h.sessionManager.CookieSecure(),
		SameSite: h.sessionManager.SameSite(),
	})

	middleware.SetFlash(c, "You have been logged out", middleware.FlashInfo)
	return respond.Redirect(c, "/login")
}

func (h *handler) setSessionCookie(c echo.Context, session *auth.Session) {
	c.SetCookie(&http.Cookie{
		Name:     h.sessionManager.CookieName(),
		Value:    session.Token,
		Path:     h.sessionManager.CookiePath(),
		Domain:   h.sessionManager.CookieDomain(),
		HttpOnly: true,
		Secure:   h.sessionManager.CookieSecure(),
		SameSite: h.sessionManager.SameSite(),
	})
}
