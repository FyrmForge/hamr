package main

import (
	"context"
	"flag"
	"log/slog"
	"os"
	"time"

	_ "github.com/joho/godotenv/autoload"
{{- if .IncludeSessions}}

	"github.com/FyrmForge/hamr/pkg/auth"
{{- end}}
	"github.com/FyrmForge/hamr/pkg/config"
{{- if eq .DBConnector "sqlx"}}
{{- if eq .Database "sqlite"}}
	db "github.com/FyrmForge/hamr/pkg/db/sqlite"
{{- else}}
	"github.com/FyrmForge/hamr/pkg/db"
{{- end}}
{{- end}}
	"github.com/FyrmForge/hamr/pkg/logging"
{{- if .IncludeSessions}}
	"github.com/FyrmForge/hamr/pkg/middleware"
{{- end}}
	"github.com/FyrmForge/hamr/pkg/server"
{{- if .IncludeStorage}}
	"github.com/FyrmForge/hamr/pkg/storage"
{{- end}}
{{- if .IncludeStripe}}
	"github.com/FyrmForge/hamr/pkg/stripemock"
{{- end}}
{{- if .IncludeEmailMock}}
	"github.com/FyrmForge/hamr/pkg/email"
	"github.com/FyrmForge/hamr/pkg/emailmock"
{{- end}}
{{- if .IncludeLocale}}
	"github.com/FyrmForge/hamr/pkg/i18n"
	"github.com/FyrmForge/hamr/pkg/ptr"
{{- end}}
{{- if .IncludeWS}}
	"github.com/FyrmForge/hamr/pkg/websocket"
{{- end}}

{{- if eq .DBConnector "sqlx"}}
{{- if .MigrateAtStartup}}
	appdb "{{.Module}}/internal/db"
{{- end}}
{{- else}}
	appdb "{{.Module}}/internal/db"
{{- end}}
{{- if eq .Database "sqlite"}}
	"{{.Module}}/internal/repo/sqlite"
{{- else}}
	"{{.Module}}/internal/repo/postgres"
{{- end}}
{{- if .IncludeAuth}}
	"{{.Module}}/internal/service"
{{- end}}
	"{{.Module}}/internal/api"
	"{{.Module}}/internal/web"
	"{{.Module}}/internal/web/components"
)

// version is set at build time via ldflags.
var version = "dev"

var (
	envPort          = config.GetEnvOrDefaultInt("PORT", 8080)
	envDevMode       = config.GetEnvOrDefaultBool("DEV_MODE", true)
	envBaseURL       = config.GetEnvOrDefault("BASE_URL", "")
{{- if eq .Database "sqlite"}}
	envDatabasePath  = config.GetEnvOrDefault("DATABASE_PATH", "./data/{{.Name | slug}}.db")
{{- else}}
	envDatabaseURL   = config.GetEnvOrDefault("DATABASE_URL", "postgres://postgres:postgres@localhost:5432/{{.Name | slug}}?sslmode=disable")
{{- end}}
	envStaticBaseURL = config.GetEnvOrDefault("STATIC_BASE_URL", "/static")
{{- if eq .StorageBackend "local"}}
	envStoragePath   = config.GetEnvOrDefault("STORAGE_PATH", "./uploads")
{{- end}}
{{- if eq .StorageBackend "s3"}}
	envS3Endpoint    = config.GetEnvOrDefault("S3_ENDPOINT", "http://localhost:9000")
	envS3Bucket      = config.GetEnvOrDefault("S3_BUCKET", "{{.Name | slug}}-uploads")
	envS3Region      = config.GetEnvOrDefault("S3_REGION", "us-east-1")
	envS3AccessKey   = config.GetEnvOrDefault("S3_ACCESS_KEY", "rustfsadmin")
	envS3SecretKey   = config.GetEnvOrDefault("S3_SECRET_KEY", "rustfsadmin")
{{- end}}
{{- if .IncludeStripe}}
	envStripeWebhookSecret = config.GetEnvOrDefault("STRIPE_WEBHOOK_SECRET", "")
	envStripeMock          = config.GetEnvOrDefaultBool("STRIPE_MOCK", false)
	envStripeCurrency      = config.GetEnvOrDefault("STRIPE_CURRENCY", "GBP")
{{- end}}
{{- if .IncludeEmailMock}}
	envEmailMock   = config.GetEnvOrDefaultBool("EMAIL_MOCK", false)
	envHamrDevURL  = config.GetEnvOrDefault("HAMR_DEV_URL", "http://localhost:3000")
{{- end}}
)

func main() {
	generateFlag := flag.Bool("generate", false, "generate static pages and exit")
	flag.Parse()

	log := logging.New(!envDevMode)
	slog.SetDefault(log)

	components.StaticBaseURL = envStaticBaseURL

	// Base URL (cookie domain & CORS).
	baseOrigin, {{- if .IncludeSessions}} baseDomain{{- else}} _{{- end}}, err := config.ParseBaseURL(envBaseURL)
	if err != nil {
		log.Error("invalid BASE_URL", "error", err)
		os.Exit(1)
	}
	components.BaseURL = baseOrigin

	// Server.
	srv, err := server.New(
		server.WithPort(envPort),
		server.WithDevMode(envDevMode),
		server.WithStaticDir("static"),
		server.WithStaticDistDir("dist"),
		server.WithGeneratedDir("generated"),
	)
	if err != nil {
		log.Error("failed to create server", "error", err)
		os.Exit(1)
	}
{{- if .IncludeSessions}}

	if baseOrigin != "" {
		srv.Echo().Use(middleware.CORSWithConfig(middleware.CORSConfig{
			AllowOrigins:     []string{baseOrigin},
			AllowCredentials: true,
		}))
	}
{{- end}}

	// Static page generation — no heavy deps needed.
	web.RegisterStaticPages(srv)
	if *generateFlag {
		if err := srv.GenerateStatic("generated"); err != nil {
			log.Error("generate static pages failed", "error", err)
			os.Exit(1)
		}
		return
	}

	// Database.
	connectCtx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
	defer cancel()
{{- if eq .DBConnector "sqlx"}}

{{- if eq .Database "sqlite"}}
	database, err := db.ConnectContext(connectCtx, envDatabasePath)
{{- else}}
	database, err := db.ConnectContext(connectCtx, envDatabaseURL)
{{- end}}
	if err != nil {
		log.Error("failed to connect to database", "error", err)
		os.Exit(1)
	}
{{- if .MigrateAtStartup}}

	// Run migrations at startup.
	if err := db.Migrate(database, appdb.MigrateConfig()); err != nil {
		log.Error("migration failed", "error", err)
		os.Exit(1)
	}
	log.Info("migrations completed")
{{- end}}

{{- if eq .Database "sqlite"}}
	store := sqlite.NewStore(database)
{{- else}}
	store := postgres.NewStore(database)
{{- end}}
{{- else}}

{{- if eq .Database "sqlite"}}
	database, err := appdb.ConnectContext(connectCtx, envDatabasePath)
{{- else}}
	database, err := appdb.ConnectContext(connectCtx, envDatabaseURL)
{{- end}}
	if err != nil {
		log.Error("failed to connect to database", "error", err)
		os.Exit(1)
	}
{{- if .MigrateAtStartup}}

	// Run migrations at startup.
	if err := appdb.AutoMigrate(database); err != nil {
		log.Error("auto-migration failed", "error", err)
		os.Exit(1)
	}
	log.Info("auto-migration completed")
{{- end}}

{{- if eq .Database "sqlite"}}
	store := sqlite.NewStore(database)
{{- else}}
	store := postgres.NewStore(database)
{{- end}}
{{- end}}
{{- if .IncludeSessions}}

	// Sessions.
	sessionManager := auth.NewSessionManager(store,
		auth.WithCookieSecure(!envDevMode),
		auth.WithCookieDomain(baseDomain),
	)
{{- end}}
{{- if .IncludeAuth}}

	// Auth service.
	authService := service.NewAuthService(store)
{{- end}}
{{- if eq .StorageBackend "local"}}

	// File storage (local).
	fileStorage, err := storage.NewLocalStorage(envStoragePath)
	if err != nil {
		log.Error("failed to init storage", "error", err)
		os.Exit(1)
	}
{{- end}}
{{- if eq .StorageBackend "s3"}}

	// File storage (S3).
	fileStorage, err := storage.NewS3Storage(storage.S3Config{
		Endpoint:       envS3Endpoint,
		Bucket:         envS3Bucket,
		Region:         envS3Region,
		AccessKeyID:    envS3AccessKey,
		SecretAccessKey: envS3SecretKey,
		UsePathStyle:   true,
	})
	if err != nil {
		log.Error("failed to init storage", "error", err)
		os.Exit(1)
	}
{{- end}}
{{- if .IncludeWS}}

	// WebSocket hub.
	hub := websocket.NewHub(websocket.WithLogger(log))
	defer hub.Close()
{{- end}}

{{- if .IncludeLocale}}

	// Locale bundle.
	localeBundle, err := i18n.NewBundle(i18n.BundleConfig{
		LocaleDir:         "locales",
		DefaultLocale:     "{{.DefaultLocale}}",
		FallbackToDefault: ptr.To(true),
	})
	if err != nil {
		log.Error("failed to load locale bundle", "error", err)
		os.Exit(1)
	}
{{- end}}

{{- if .IncludeStripe}}

	// Local Stripe mock for development: serves a fake checkout page at
	// /dev/stripe when STRIPE_MOCK=true. Leave unset in production.
	var stripeMock *stripemock.Client
	if envStripeMock {
		stripeMock = stripemock.New(baseOrigin, envStripeCurrency)
		stripemock.Mount(srv.Echo(), stripeMock)
		log.Info("stripe mock enabled", "path", "/dev/stripe")
	}
{{- end}}
{{- if .IncludeEmailMock}}

	// Email sender. In dev (EMAIL_MOCK=true), ships messages to the hamr dev
	// inbox at HAMR_DEV_URL/__hamr/mail. Swap for a real provider adapter in
	// production.
	var emailSender email.Sender
	if envEmailMock {
		emailSender = emailmock.New(envHamrDevURL)
		log.Info("email mock enabled", "inbox", envHamrDevURL+"/__hamr/mail")
	}
{{- end}}

	api.RegisterRoutes(srv, &api.Deps{
		Store: store,
{{- if .IncludeStripe}}
		WebhookSecret: envStripeWebhookSecret,
{{- end}}
	})

	web.RegisterRoutes(srv, &web.Deps{
		Store:         store,
		BaseURL:       baseOrigin,
		StaticBaseURL: envStaticBaseURL,
		DevMode:       envDevMode,
{{- if .IncludeSessions}}
		SessionManager: sessionManager,
{{- end}}
{{- if .IncludeAuth}}
		AuthService: authService,
{{- end}}
{{- if .IncludeStorage}}
		FileStorage: fileStorage,
{{- end}}
{{- if .IncludeWS}}
		Hub: hub,
{{- end}}
{{- if .IncludeLocale}}
		LocaleBundle: localeBundle,
{{- end}}
{{- if .IncludeStripe}}
		StripeMock: stripeMock,
{{- end}}
{{- if .IncludeEmailMock}}
		EmailSender: emailSender,
{{- end}}
	})

	log.Info("starting server", "port", envPort, "devMode", envDevMode)
	if err := srv.Start(); err != nil {
		log.Error("server stopped", "error", err)
		os.Exit(1)
	}
}
