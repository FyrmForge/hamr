package stripemock

import "fmt"

templ checkoutPage(sessionID, currency string, req *CheckoutRequest) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Mock Stripe Checkout</title>
			<style>
				* { margin: 0; padding: 0; box-sizing: border-box; }
				body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0a2540; color: #fff; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
				.checkout { background: #1a3a5c; border-radius: 12px; padding: 40px; max-width: 480px; width: 100%; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
				.badge { display: inline-block; background: #ff6b35; color: #fff; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 4px; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.05em; }
				h1 { font-size: 22px; margin-bottom: 24px; }
				.items { border-top: 1px solid rgba(255,255,255,0.1); margin-bottom: 24px; }
				.item { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.1); font-size: 14px; }
				.item-name { color: #a3c4e0; }
				.item-price { font-weight: 600; }
				.total { display: flex; justify-content: space-between; padding: 16px 0; font-size: 18px; font-weight: 700; border-top: 2px solid rgba(255,255,255,0.2); margin-bottom: 32px; }
				.actions { display: flex; flex-direction: column; gap: 10px; }
				button { padding: 14px; border: none; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; font-family: inherit; transition: filter 0.15s; }
				button:hover { filter: brightness(1.1); }
				.btn-pay { background: #635bff; color: #fff; }
				.btn-fail { background: #df1b41; color: #fff; }
				.btn-cancel { background: transparent; color: #a3c4e0; border: 1px solid rgba(255,255,255,0.15); }
				.session-id { font-size: 11px; color: #5a7a9a; margin-top: 20px; word-break: break-all; }
				.meta { font-size: 12px; color: #5a7a9a; margin-top: 8px; }
			</style>
		</head>
		<body>
			<div class="checkout">
				<span class="badge">Dev Mock</span>
				<h1>Stripe Checkout</h1>
				<div class="items">
					for _, item := range req.LineItems {
						<div class="item">
							<span class="item-name">{ item.Name } x{ fmt.Sprintf("%d", item.Quantity) }</span>
							<span class="item-price">{ formatAmount(item.Amount * item.Quantity, currency) }</span>
						</div>
					}
				</div>
				<div class="total">
					<span>Total</span>
					<span>{ formatAmount(calcTotal(req.LineItems), currency) }</span>
				</div>
				<p style="font-size:13px;color:#a3c4e0;margin-bottom:20px">Choose the outcome for this payment:</p>
				<div class="actions">
					<form method="POST" action="/dev/stripe/complete">
						<input type="hidden" name="session" value={ sessionID }/>
						<input type="hidden" name="outcome" value="paid"/>
						<button type="submit" class="btn-pay" style="width:100%">Pay Successfully</button>
					</form>
					<form method="POST" action="/dev/stripe/complete">
						<input type="hidden" name="session" value={ sessionID }/>
						<input type="hidden" name="outcome" value="failed"/>
						<button type="submit" class="btn-fail" style="width:100%">Card Declined</button>
					</form>
					<form method="POST" action="/dev/stripe/complete">
						<input type="hidden" name="session" value={ sessionID }/>
						<input type="hidden" name="outcome" value="cancelled"/>
						<button type="submit" class="btn-cancel" style="width:100%">Cancel Payment</button>
					</form>
				</div>
				<p class="session-id">Session: { sessionID }</p>
				if len(req.Metadata) > 0 {
					<div class="meta">
						for k, v := range req.Metadata {
							<p>{ k }: { v }</p>
						}
					</div>
				}
			</div>
		</body>
	</html>
}

// formatAmount renders an amount (in the smallest currency unit) using a
// currency-appropriate symbol and decimal precision. Unknown codes fall
// through as "<CODE> 0.00".
func formatAmount(amount int64, currency string) string {
	switch currency {
	case "GBP":
		return fmt.Sprintf("£%.2f", float64(amount)/100)
	case "USD":
		return fmt.Sprintf("$%.2f", float64(amount)/100)
	case "EUR":
		return fmt.Sprintf("€%.2f", float64(amount)/100)
	case "JPY":
		return fmt.Sprintf("¥%d", amount)
	default:
		return fmt.Sprintf("%s %.2f", currency, float64(amount)/100)
	}
}

func calcTotal(items []LineItem) int64 {
	var total int64
	for _, item := range items {
		total += item.Amount * item.Quantity
	}
	return total
}
