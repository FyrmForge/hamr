package form

import "strconv"

// FieldError renders a validation error for a form field.
// Always renders the element so it can be targeted by OOB swaps.
templ FieldError(field string, err string) {
{{- if eq .CSS "tailwind"}}
	<span class="text-red-400 text-sm mt-1 block" id={ "error-" + field } data-has-error={ strconv.FormatBool(err != "") } aria-live="polite">
{{- else}}
	<span class="field-error" id={ "error-" + field } data-has-error={ strconv.FormatBool(err != "") } aria-live="polite">
{{- end}}
		if err != "" {
			{ err }
		}
	</span>
}

// FieldErrorOOB renders an out-of-band swap for a field error (used with HTMX blur validation).
templ FieldErrorOOB(field string, err string) {
{{- if eq .CSS "tailwind"}}
	<span class="text-red-400 text-sm mt-1 block" id={ "error-" + field } data-has-error={ strconv.FormatBool(err != "") } aria-live="polite" hx-swap-oob="true">
{{- else}}
	<span class="field-error" id={ "error-" + field } data-has-error={ strconv.FormatBool(err != "") } aria-live="polite" hx-swap-oob="true">
{{- end}}
		if err != "" {
			{ err }
		}
	</span>
}

// CSRFField renders a hidden CSRF token input.
templ CSRFField(token string) {
	<input type="hidden" name="csrf_token" value={ token }/>
}
