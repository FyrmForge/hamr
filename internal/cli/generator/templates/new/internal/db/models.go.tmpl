package db

{{- $hasModels := or .IncludeSessions (and .IncludeAuth .AuthWithTables)}}
{{- if $hasModels}}

import "{{.Module}}/internal/repo"
{{- end}}

// models returns all GORM model structs for auto-migration.
//
// The structs themselves live in internal/repo next to their stores — their
// gorm tags are the schema.
func models() []any {
	return []any{
{{- if .IncludeSessions}}
		&repo.Session{},
{{- end}}
{{- if and .IncludeAuth .AuthWithTables}}
		&repo.User{},
{{- end}}
{{- if not $hasModels}}
		// Add your model structs here, e.g.:
		// &repo.Example{},
{{- end}}
	}
}
