[proxy]
listen = ":3000"
target = ":8080"
inject_reload = true

[[dev.watch]]
name = "templ"
watch = "**/*.templ"
ignore = "*_templ.go"
cmd = "templ generate"
debounce = 100
{{- if eq .CSS "tailwind"}}

[[dev.daemon]]
name = "tailwind"
cmd = "npm run css"
{{- end}}
{{- if .StaticS3}}

[[dev.daemon]]
name = "sync-static"
cmd = "hamr sync --watch --bucket {{.Name}}-static"
{{- end}}

[[dev.watch]]
name = "go"
watch = ["**/*.go", "**/*.templ"]
ignore = ["*_templ.go", "*_test.go"]
cmd = "go build -o ./bin/app ./cmd/server"
run = "./bin/app"
depends = ["templ"]
reload = "full"

