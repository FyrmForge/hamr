# Site
PORT=8080
DEV_MODE=true

# Base URL (set in production for cookie domain and CORS, leave empty for local dev)
# BASE_URL=https://example.com

# Database
{{- if eq .Database "sqlite"}}
DATABASE_PATH=./data/{{.Name | slug}}.db
{{- else}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{.Name | slug}}?sslmode=disable
{{- end}}
{{- if eq .StorageBackend "local"}}

# Storage
STORAGE_PATH=./uploads
{{- end}}
{{- if eq .StorageBackend "s3"}}

# S3 Storage (RustFS)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET={{.Name | slug}}-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
{{- if .StaticS3}}
S3_STATIC_BUCKET={{.Name | slug}}-static
{{- end}}
{{- end}}

{{- if .IncludePgAdmin}}

# pgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
{{- end}}
{{- if .IncludeStripe}}

# Stripe
STRIPE_WEBHOOK_SECRET=whsec_...
# Serves a mock Stripe checkout at /dev/stripe. Leave unset or "false" in prod.
STRIPE_MOCK=true
# ISO 4217 currency code used by the mock checkout (GBP, USD, EUR, JPY, ...).
STRIPE_CURRENCY=GBP
{{- end}}
{{- if .IncludeEmailMock}}

# Email mock
# Routes outbound mail through pkg/emailmock to the hamr dev inbox at /__hamr/mail.
# Leave unset or "false" in prod (swap in your real provider adapter there).
EMAIL_MOCK=true
# Base URL of the hamr dev proxy (where the mock ingests messages).
HAMR_DEV_URL=http://localhost:3000
{{- end}}

# Static assets base URL (override with CDN URL in production)
STATIC_BASE_URL=/static
