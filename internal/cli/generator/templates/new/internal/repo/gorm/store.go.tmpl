package {{if eq .Database "sqlite"}}sqlite{{else}}postgres{{end}}

import (
	"context"
{{- if .IncludeSessions}}
	"errors"

	"{{.Module}}/internal/repo"
	"github.com/FyrmForge/hamr/pkg/auth"
{{- end}}
	"gorm.io/gorm"
)

// Store implements repo.Store using {{if eq .Database "sqlite"}}SQLite{{else}}PostgreSQL{{end}} via GORM.
type Store struct {
	db *gorm.DB
}

// NewStore creates a new {{if eq .Database "sqlite"}}SQLite{{else}}PostgreSQL{{end}}-backed store.
func NewStore(db *gorm.DB) *Store {
	return &Store{db: db}
}

// Health checks the database connection.
func (s *Store) Health(ctx context.Context) error {
	sqlDB, err := s.db.DB()
	if err != nil {
		return err
	}
	return sqlDB.PingContext(ctx)
}

// DB returns the underlying GORM database connection.
func (s *Store) DB() *gorm.DB {
	return s.db
}
{{- if .IncludeSessions}}

// ---------------------------------------------------------------------------
// auth.SessionStore implementation
// ---------------------------------------------------------------------------

// Create inserts a new session row.
func (s *Store) Create(ctx context.Context, session *auth.Session) error {
	return s.db.WithContext(ctx).Create(repo.SessionFromAuth(session)).Error
}

func (s *Store) GetByToken(ctx context.Context, token string) (*auth.Session, error) {
	var row repo.Session
	err := s.db.WithContext(ctx).Where("token = ?", token).First(&row).Error
	if err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			return nil, nil
		}
		return nil, err
	}
	return row.ToAuth(), nil
}

func (s *Store) Delete(ctx context.Context, id string) error {
	return s.db.WithContext(ctx).Where("id = ?", id).Delete(&repo.Session{}).Error
}

func (s *Store) DeleteBySubjectID(ctx context.Context, subjectID string) error {
	return s.db.WithContext(ctx).Where("subject_id = ?", subjectID).Delete(&repo.Session{}).Error
}
{{- end}}
