package web

import (
{{- if .IncludeAuth}}
	"context"
{{- end}}

	hamrmw "github.com/FyrmForge/hamr/pkg/middleware"
	"github.com/FyrmForge/hamr/pkg/server"
{{- if .IncludeSessions}}
	"github.com/FyrmForge/hamr/pkg/auth"
{{- end}}
{{- if .IncludeStorage}}
	"github.com/FyrmForge/hamr/pkg/storage"
{{- end}}
{{- if .IncludeLocale}}
	"github.com/FyrmForge/hamr/pkg/i18n"
{{- end}}
{{- if .IncludeWS}}
	"github.com/FyrmForge/hamr/pkg/websocket"
{{- end}}

	"{{.Module}}/internal/middleware"
	"{{.Module}}/internal/repo"
{{- if .IncludeAuth}}
	"{{.Module}}/internal/service"
	authhandler "{{.Module}}/internal/web/handler/auth"
{{- end}}
	"{{.Module}}/internal/web/handler/about"
	"{{.Module}}/internal/web/handler/health"
	"{{.Module}}/internal/web/handler/home"
	"{{.Module}}/internal/web/components"
)

// Deps holds the dependencies for route registration.
type Deps struct {
	Store          repo.Store
	BaseURL        string
	StaticBaseURL  string
	DevMode        bool
{{- if .IncludeSessions}}
	SessionManager *auth.SessionManager
{{- end}}
{{- if .IncludeAuth}}
	AuthService *service.AuthService
{{- end}}
{{- if .IncludeStorage}}
	FileStorage storage.FileStorage
{{- end}}
{{- if .IncludeWS}}
	Hub *websocket.Hub
{{- end}}
{{- if .IncludeLocale}}
	LocaleBundle *i18n.Bundle
{{- end}}
}

// RegisterRoutes registers all web route handlers on the server.
func RegisterRoutes(srv *server.Server, deps *Deps) {
	e := srv.Echo()

	// Health check — no session middleware.
	healthHandler := health.NewHandler(deps.Store)
	e.GET("/health", healthHandler.Health)
{{- if .IncludeWS}}

	// WebSocket endpoint.
	e.GET("/ws", deps.Hub.Handler())
{{- end}}

	// Content Security Policy.
	csp := "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
{{- if .IncludeWS}}
	csp += "; connect-src 'self' ws: wss:"
{{- end}}

	// Site routes.
	site := e.Group("")
	site.Use(middleware.Logging())
	site.Use(hamrmw.ErrorPages(components.ErrorPage))
	site.Use(hamrmw.SecureWithConfig(hamrmw.SecureConfig{
		ContentSecurityPolicy: csp,
	}))
{{- if .IncludeSessions}}
	site.Use(hamrmw.FlashWithConfig(hamrmw.FlashConfig{Secure: !deps.DevMode}))
	site.Use(hamrmw.CSRFWithConfig(hamrmw.CSRFConfig{Secure: !deps.DevMode}))
{{- end}}
{{- if .IncludeLocale}}
	site.Use(hamrmw.LocaleFromPreference(hamrmw.LocaleConfig{
		Bundle:       deps.LocaleBundle,
		CookieSecure: !deps.DevMode,
	}))
{{- end}}
{{- if .IncludeAuth}}

	auth := hamrmw.NewBrowserAuth(deps.SessionManager,
		hamrmw.WithSubjectLoader(func(reqCtx context.Context, id string) (any, error) {
			return deps.Store.GetUserByID(reqCtx, id)
		}),
		hamrmw.WithLoginRedirect("/login"),
		hamrmw.WithHomeRedirect("/"),
	)
	site.Use(auth.Load())
{{- end}}

	homeHandler := home.NewHandler()
	site.GET("/", homeHandler.Index)
{{- if .IncludeAuth}}

	// Auth routes.
	authHandler := authhandler.NewHandler(deps.AuthService, deps.SessionManager)

	site.GET("/login", authHandler.LoginPage, auth.RequireNotAuth())
	site.POST("/login", authHandler.Login, auth.RequireNotAuth())
	site.POST("/login/validate/:field", authHandler.LoginFormRules.ValidationHandler("field"), auth.RequireNotAuth())

	site.GET("/register", authHandler.RegisterPage, auth.RequireNotAuth())
	site.POST("/register", authHandler.Register, auth.RequireNotAuth())
	site.POST("/register/validate/:field", authHandler.RegisterFormRules.ValidationHandler("field"), auth.RequireNotAuth())

	site.POST("/logout", authHandler.Logout, auth.RequireAuth())
{{- end}}
}

// RegisterStaticPages registers handlers for static generation and runtime
// serving. Each call to StaticPage registers both a generation entry and a
// GET route. These handlers must not depend on database or session state.
func RegisterStaticPages(srv *server.Server) {
	h := about.NewHandler()
	srv.StaticPage("/about", h.About)
}
