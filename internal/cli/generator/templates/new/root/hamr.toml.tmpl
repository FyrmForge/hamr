[proxy]
listen = ":3000"
target = ":8080"
inject_reload = true

[[dev.docker_compose]]
name = "deps"
file = "docker/docker-compose.yaml"
keep_running = true

[[dev.watch]]
name = "templ"
watch = "**/*.templ"
ignore = "*_templ.go"
cmd = "templ generate"
debounce = 100
{{- if eq .CSS "tailwind"}}

[[dev.daemon]]
name = "tailwind"
cmd = "npm run css"
{{- end}}
{{- if .StaticS3}}

[[dev.daemon]]
name = "sync-static"
cmd = "hamr sync --watch --bucket {{.Name}}-static"
{{- end}}
{{- if .IncludeLocale}}

[[dev.watch]]
name = "locale"
watch = "locales/*.json"
cmd = "hamr locale gen"
debounce = 200
{{- end}}

[[dev.watch]]
name = "site"
watch = ["**/*.go", "**/*.templ"]
ignore = ["*_templ.go", "*_test.go"]
cmd = "go build -o ./bin/app ./cmd/server"
run = "./bin/app"
depends = ["templ"{{- if .IncludeLocale}}, "locale"{{- end}}]
reload = "full"

